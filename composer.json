{
    "name": "maithemewp/mai-analytics",
    "description": "View tracking for posts, terms, and authors. Supports self-hosted tracking, Google Analytics (via Site Kit), Matomo, and Jetpack Stats.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/maithemewp/mai-logger"
        },
        {
            "type": "vcs",
            "url": "https://github.com/bizbudding/deployable-guard"
        }
    ],
    "require": {
        "yahnis-elsts/plugin-update-checker": "^5.0",
        "maithemewp/mai-logger": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "bizbudding/deployable-guard": "^1"
    },
    "autoload": {
        "psr-4": {
            "Mai\\Analytics\\": "src/"
        }
    },
    "scripts": {
        "update-bots": "php bin/update-bot-patterns.php",
        "test": "phpunit",
        "install-git-hooks": [
            "sh -c 'test -f vendor/bin/deployable-guard && php vendor/bin/deployable-guard install-hook || true'"
        ],
        "post-install-cmd": [
            "@install-git-hooks"
        ],
        "post-update-cmd": [
            "@install-git-hooks"
        ]
    }
}
